{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetObject",
                "s3:GetBucketLocation"
            ],
            "Resource": [
                "arn:aws:s3:::cpgpt-lucascamillo-public",
                "arn:aws:s3:::cpgpt-lucascamillo-public/*"
            ],
            "Condition": {
                "StringEquals": {
                    "s3:RequestPayer": "requester"
                }
            }
        }
    ]
}
